# Copy to .env for local runs, or set these in Railway.
# Never commit real credentials.

# ---- credentials (required) ----
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=
ADMIN_TOKEN=

# ---- environment ----
# demo = paper money, prod = real money
KALSHI_ENV=demo
KALSHI_SERIES_TICKER=KXBTC15M
# Attach a Railway volume here, or restarts lose halts and open lot tracking
DATA_DIR=/app/data

# ---- autonomy ----
# off | dryrun | live
TRADING_MODE=off

# ---- entry ----
MIN_EDGE_CENTS=2.0
MIN_CONFIDENCE=55
MAX_SPREAD_CENTS=4
MIN_EXIT_LIQUIDITY=25
MIN_PRICE_CENTS=15
MAX_PRICE_CENTS=85
MIN_SECONDS_TO_CLOSE=180
MAX_SECONDS_TO_CLOSE=900
VOL_WINDOW_SECONDS=300
MIN_HISTORY_SECONDS=120

# ---- the profit ladder (percentages must total 100) ----
SCALP_SMALL_CENTS=3
SCALP_SMALL_PCT=50
SCALP_MEDIUM_CENTS=7
SCALP_MEDIUM_PCT=30
SCALP_LARGE_CENTS=14
SCALP_LARGE_PCT=20

# ---- exits that are not profits ----
SCALP_STOP_CENTS=6
SCALP_TRAIL_CENTS=3
SCALP_MAX_HOLD_SECONDS=300
SCALP_SETTLEMENT_GUARD_SECONDS=90
SCALP_SMALL_LOT_EXIT_TIER=medium

# ---- risk ----
# The cost cap is the real size control. The contract count is only a
# backstop: at a 40c ask, $20 is 50 contracts, so a low count cap silently
# shrinks every position.
MAX_CONTRACTS_PER_TRADE=60
MAX_COST_PER_TRADE_CENTS=2000
MIN_COST_PER_TRADE_CENTS=500
DAILY_LOSS_LIMIT_CENTS=2000
MAX_TRADES_PER_DAY=40
MAX_OPEN_POSITIONS=2
COOLDOWN_SECONDS=20

# ---- timing ----
# Upper bound on how long the loop will sleep when the book is quiet. The loop
# is event-driven: a book update wakes it immediately, so this is a fallback
# heartbeat, not the reaction time.
TRADE_LOOP_SECONDS=0.25
# Floor between ticks. The loop is event-driven, so on a fast tape the wake
# signal is already set again before the tick finishes and the loop would never
# yield -- pinning a core and adding scheduling jitter to the exit path. 20ms is
# far below any timescale the strategy reasons about.
TRADE_LOOP_MIN_SECONDS=0.02
BOOK_POLL_SECONDS=2.0
RECONCILE_SECONDS=30.0

# ---- consolidated spot feed ----
# Several venues at once, merged into a median print. One venue cannot tell a
# real move from its own glitch, and acting on a glitch is worse than missing a
# move. When the venues disagree by more than SPOT_DIVERGENCE_BPS, or fewer
# than SPOT_MIN_SOURCES are alive, entries stop -- one of the feeds is wrong
# and nothing here can tell which.
SPOT_FEEDS=coinbase,binanceus,kraken
SPOT_MIN_SOURCES=2
SPOT_DIVERGENCE_BPS=8.0

# ---- the contract's own chart ----
# A rolling record of the CONTRACT's bid/ask, not just BTC's price. Without
# this the bot could not see a dip in the thing it was actually trading.
TAPE_SECONDS=900
TAPE_MIN_SAMPLES=12

# ---- dip / dislocation entries ----
# The lane that buys a contract that has sold off while the underlying has not.
# DIP_MAX_SPOT_MOVE_BPS is the load-bearing setting: if spot really moved, the
# contract is repriced rather than discounted, and buying it is taking the
# wrong side of a real move.
DIP_ENTRY=1
DIP_DISLOCATION=1
DIP_REVERSION=1
DIP_LOOKBACK_SECONDS=90
DIP_MIN_DROP_CENTS=6.0
DIP_REVERSION_MIN_DROP_CENTS=10.0
DIP_MIN_EDGE_CENTS=3.0
DIP_MAX_SPOT_MOVE_BPS=12.0
# Wait for the fall to stall before buying it. Turning this off buys knives.
DIP_REQUIRE_DECEL=1
DIP_STABILIZE_SECONDS=3.0
DIP_DECEL_TOLERANCE=0.15
DIP_MIN_IMBALANCE=0.0
DIP_MIN_SECONDS_TO_CLOSE=180
# The dip lane's own pacing. Several genuine dislocations in one 15-minute
# window is normal and is the whole point of re-entry, so these are looser
# than the trend lane's -- but still bounded.
DIP_MAX_ENTRIES_PER_MARKET=4
DIP_COOLDOWN_SECONDS=8
DIP_STOP_COOLDOWN_SECONDS=30
# A dip entry expects a few more cents against it before the recovery.
DIP_STOP_MULT=1.4

# ---- exits: runner or ladder ----
# runner = hold, and exit on a trailing stop that widens with the peak.
# ladder = the old fixed take-profit rungs (sells half at +3c).
# The ladder caps every winner at its top rung by construction; that is what
# it is for. Use it if you want many small round trips instead of few large
# ones.
EXIT_PROFILE=runner
# No trail until the position has moved this far -- inside this, the position
# is protected by the hard stop only.
RUNNER_ARM_CENTS=4
# Trail distance as a fraction of the peak gain, clamped to the bounds below.
RUNNER_TRAIL_FRAC=0.35
# The floor MUST exceed MAX_SPREAD_CENTS or the trail fires on spread alone.
RUNNER_TRAIL_MIN_CENTS=5
RUNNER_TRAIL_MAX_CENTS=12
# Tighten the trail when the chart turns against an open position.
RUNNER_FLIP_TIGHTEN=0.5
# Do not apply the max-hold timer to a position that is winning.
RUNNER_HOLD_WINNERS=1
# Optional single partial sale. 0 disables it, which is the default: taking
# money off a runner is the behaviour this profile exists to stop.
RUNNER_PARTIAL_PCT=0
RUNNER_PARTIAL_CENTS=10

# ---- conviction sizing ----
# Scales the per-trade budget between MIN_COST_PER_TRADE_CENTS and
# MAX_COST_PER_TRADE_CENTS by the signal's conviction score. Every hard risk
# cap still applies on top and can only reduce the result.
CONVICTION_SIZING=1

# ---- latency ----
# How stale the in-memory WebSocket book may be before an exit falls back to a
# REST fetch. The socket book is the fast path; REST is the safety net.
BOOK_MAX_AGE_SECONDS=2.0
# Order-status polling is throttled separately from the loop: it is a
# rate-limited REST call, and nothing about a resting order changes faster
# than this.
PENDING_POLL_SECONDS=0.5
