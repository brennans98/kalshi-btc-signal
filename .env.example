# Copy these into Railway's Variables tab. Do not commit real values.

# --- mode ---
TRADING_MODE=off
KALSHI_ENV=demo

# --- credentials ---
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=
ADMIN_TOKEN=

# --- market ---
KALSHI_SERIES_TICKER=KXBTC15M
LOOP_INTERVAL_SECONDS=5

# --- signal thresholds ---
MIN_EDGE_CENTS=3.0
MIN_CONFIDENCE=58
MAX_SPREAD_CENTS=8
MIN_PRICE_CENTS=8
MAX_PRICE_CENTS=92
MIN_SECONDS_TO_CLOSE=75
MAX_SECONDS_TO_CLOSE=900

# --- risk limits ---
MAX_CONTRACTS_PER_TRADE=5
MAX_COST_PER_TRADE_CENTS=500
MAX_OPEN_POSITIONS=1
MAX_TRADES_PER_DAY=12
DAILY_LOSS_LIMIT_CENTS=2000
COOLDOWN_SECONDS=60

# --- state ---
RISK_STATE_PATH=data/risk_state.json
DECISION_LOG_PATH=data/decisions.jsonl
