# Copy to .env for local runs, or set these in Railway.
# Never commit real credentials.

# ---- credentials (required) ----
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=
ADMIN_TOKEN=

# ---- environment ----
# demo = paper money, prod = real money
KALSHI_ENV=demo
KALSHI_SERIES_TICKER=KXBTC15M
# Attach a Railway volume here, or restarts lose halts and open lot tracking
DATA_DIR=/app/data

# ---- autonomy ----
# off | dryrun | live
TRADING_MODE=off

# ---- entry ----
MIN_EDGE_CENTS=2.0
MIN_CONFIDENCE=55
MAX_SPREAD_CENTS=4
MIN_EXIT_LIQUIDITY=25
MIN_PRICE_CENTS=15
MAX_PRICE_CENTS=85
MIN_SECONDS_TO_CLOSE=180
MAX_SECONDS_TO_CLOSE=900
VOL_WINDOW_SECONDS=300
MIN_HISTORY_SECONDS=120

# ---- the profit ladder (percentages must total 100) ----
SCALP_SMALL_CENTS=3
SCALP_SMALL_PCT=50
SCALP_MEDIUM_CENTS=7
SCALP_MEDIUM_PCT=30
SCALP_LARGE_CENTS=14
SCALP_LARGE_PCT=20

# ---- exits that are not profits ----
SCALP_STOP_CENTS=6
SCALP_TRAIL_CENTS=3
SCALP_MAX_HOLD_SECONDS=300
SCALP_SETTLEMENT_GUARD_SECONDS=90
SCALP_SMALL_LOT_EXIT_TIER=medium

# ---- risk ----
MAX_CONTRACTS_PER_TRADE=6
MAX_COST_PER_TRADE_CENTS=500
DAILY_LOSS_LIMIT_CENTS=2000
MAX_TRADES_PER_DAY=40
MAX_OPEN_POSITIONS=2
COOLDOWN_SECONDS=20

# ---- timing ----
TRADE_LOOP_SECONDS=2.0
BOOK_POLL_SECONDS=2.0
RECONCILE_SECONDS=30.0
